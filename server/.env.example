# Copy to .env and fill in. Committed as documentation of required env vars.
PORT=4000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=your_pg_user
DATABASE_PASSWORD=
DATABASE_NAME=documind

JWT_ACCESS_SECRET=change-me
JWT_REFRESH_SECRET=change-me

# File storage adapter (upload stage). local = write to STORAGE_LOCAL_DIR (offline).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
# Switch to S3 (or MinIO/R2) by setting STORAGE_DRIVER=s3 and the vars below:
# STORAGE_DRIVER=s3
# S3_BUCKET=documind-uploads
# AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=...
# AWS_SECRET_ACCESS_KEY=...
# S3_ENDPOINT=   # optional: MinIO / Cloudflare R2 / DigitalOcean Spaces
